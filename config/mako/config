# Mako: full monochrome notifications with 5-second auto-dismiss

font=monospace 11
background-color=#0d0d0d
text-color=#d7d7d7
border-color=#3a3a3a
border-size=1
border-radius=12
padding=12
margin=12
width=350
layer=top
anchor=top-right
icons=1
max-icon-size=32
icon-location=left
progress-color=#d7d7d7 over
default-timeout=5000
ignore-timeout=1
format=<b>%s</b>\n%b
