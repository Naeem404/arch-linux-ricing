/* Monochrome ASCII rofi theme */
* {
    bg:      rgba(13, 13, 13, 0.65);
    bg-sel:  rgba(43, 43, 43, 0.40);
    fg:      #d7d7d7;
    fg-dim:  #7f7f7f;
    fg-sel:  #ffffff;
    bc:      #3a3a3a;

    background-color: transparent;
    text-color:       @fg;
    font:             "monospace 12";
}

window {
    background-color: @bg;
    border:           1px;
    border-color:     @bc;
    border-radius:    12px;
    width:            620px;
    padding:          10px;
}

mainbox {
    spacing:  10px;
    children: [ inputbar, listview ];
}

inputbar {
    spacing:      8px;
    padding:      6px 10px;
    border:       0 0 1px 0;
    border-color: @bc;
    children:     [ prompt, entry ];
}

prompt {
    text-color: @fg-dim;
}

entry {
    text-color:        @fg;
    placeholder:       "search";
    placeholder-color: @fg-dim;
    cursor:            text;
}

listview {
    lines:        10;
    columns:      1;
    scrollbar:    false;
    spacing:      2px;
    fixed-height: false;
}

element {
    padding:          7px 10px;
    spacing:          12px;
    border-radius:    8px;
    background-color: transparent;
    text-color:       @fg;
    children:         [ element-icon, element-text ];
}

element normal normal,
element normal active,
element normal urgent {
    background-color: transparent;
    text-color:       @fg;
}

element selected normal,
element selected active,
element selected urgent {
    background-color: @bg-sel;
    text-color:       @fg-sel;
}

element-icon {
    size:             22px;
    vertical-align:   0.5;
    background-color: transparent;
}

element-text {
    vertical-align:   0.5;
    text-color:       inherit;
    background-color: transparent;
}
